# ─────────────────────────────────────────────────────────────
# LEARN: This file documents every environment variable the app needs.
# Copy it to .env and fill in real values — the app reads .env at startup.
# Never commit .env to git (it contains secrets).
# ─────────────────────────────────────────────────────────────

# JWT Secret — any long random string. Used to sign and verify tokens.
# LEARN: If you change this, all existing tokens become invalid (everyone gets logged out).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Cloudinary — free account at cloudinary.com
# After signing up, find these in Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
PORT=8080
DB_PATH=gamelog.db
